/.well-known/apple-app-site-association
  Content-Type: application/json

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; child-src 'self' blob:; img-src 'self' data: blob: https://www.googletagmanager.com https://www.google-analytics.com https://tiles.openfreemap.org; font-src 'self'; media-src 'self'; connect-src 'self' https://tiles.openfreemap.org https://uejmhtdfbqbotvbqvfja.supabase.co wss://uejmhtdfbqbotvbqvfja.supabase.co https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# HTML must always revalidate. A stale HTML document pins the old ?v= query on
# every stylesheet and script, which is how a shipped CSS fix can stay invisible
# for hours. Revalidating the document costs one 304 and makes deploys instant.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed filenames. Safe to pin for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Referenced with an explicit ?v= cache-busting query, so a new HTML document
# always requests a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Media is replaced by hand rather than by version bump, so keep the window
# short enough that a corrected asset reaches everyone within a month.
/images/*
  Cache-Control: public, max-age=2592000

/videos/*
  Cache-Control: public, max-age=2592000

# Calendar files. The event page's "Add to calendar" only offers to add an
# event if the response is text/calendar; served as octet-stream, iOS saves it
# to Files and nothing happens. Short cache because the file is regenerated
# whenever the event record is re-verified, and it is deleted once the event
# has passed.
/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
